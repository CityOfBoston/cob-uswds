<form class="cob-form">
  <div class="cob-character-count">
    <label class="cob-label" for="with-hint-input">Text input</label>
    <span id="with-hint-input-hint" class="cob-hint">This is an input with a character counter.</span>
    <input
      class="cob-input cob-character-count__field"
      id="with-hint-input"
      maxlength="25"
      name="with-hint-input"
      aria-describedby="with-hint-input-info with-hint-input-hint"
    >
    <span id="with-hint-input-info" class="cob-character-count__message">You can enter up to 25 characters</span>
  </div>
</form>

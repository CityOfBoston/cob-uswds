{% set stickToBottom = stickToBottom|default(false) %}

<div class="cob-slim-footer{% if stickToBottom %} cob-slim-footer--sticky{% endif %}">
  <div class="cob-slim-footer__content">
    <div class="cob-slim-footer__left">
      <img src="./img/cob-footer-icon.png" alt="City of Boston" class="cob-slim-footer__icon">
    </div>
    
    <nav class="cob-slim-footer__nav">
      <ul class="cob-slim-footer__nav-list">
        <li><a href="{{ privacyPolicyUrl }}">PRIVACY POLICY</a></li>
        <li><a href="{{ contactUrl }}">CONTACT US</a></li>
        <li><a href="{{ jobsUrl }}">JOBS</a></li>
        <li><a href="{{ publicRecordsUrl }}">PUBLIC RECORDS</a></li>
        <li><a href="{{ accessibilityUrl }}">LANGUAGE AND DISABILITY ACCESS</a></li>
      </ul>
    </nav>

    <div class="cob-slim-footer__right">
      <a href="{{ reportIssueUrl }}" class="cob-slim-footer__report">
        <span>Report an issue</span>
        <img src="./img/cob-311.svg" alt="311" class="cob-slim-footer__311-icon">
      </a>
    </div>
  </div>
</div> 
<form class="cob-form">
  <label class="cob-label" for="example-input-suffix">Weight, in pounds</label>
  <div class="cob-input-group {{ utilities | default('cob-input-group--sm') }}">
    <input type="text" id="example-input-suffix" class="cob-input" pattern="[0-9]*" inputmode="numeric"
    {% if disabled_state == "disabled"%} disabled{%- endif %}
    {% if disabled_state == "aria-disabled"%} aria-disabled="true"{%- endif %}
    >
    <div class="cob-input-suffix" aria-hidden="true">
      lbs.
    </div>
  </div>
</form>

<div class="cob-sign-up">
  <h3 class="cob-sign-up__heading">Sign up</h3>
  <form class="cob-form">
    <label class="cob-label" for="email" id="">Your email address</label>
    <input class="cob-input" id="email" name="email" type="email" autocomplete="email"/>
    <button class="cob-button" type="submit">Sign up</button>
  </form>
</div>

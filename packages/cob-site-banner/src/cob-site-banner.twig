{% set banner_id = "cob-site-banner-content" %}

<div class="cob-site-banner" data-site-banner>
  <div class="cob-site-banner__content">
    <div class="cob-site-banner__left">
      <img src="{{ bostonIcon }}" alt="Boston.gov Icon" class="cob-site-banner__icon" />
      <span>{{ bannerText }} 
        <button class="cob-site-banner__toggle" aria-expanded="{{ isExpanded ? 'true' : 'false' }}" aria-controls="{{ banner_id }}">
          {{ toggleText }}
        </button>
        <noscript>
          <a href="#{{ banner_id }}" class="cob-site-banner__toggle">{{ toggleText }}</a>
        </noscript>
      </span>
    </div>
    <div class="cob-site-banner__right">
      <button class="cob-site-banner__toggle-icon" aria-expanded="{{ isExpanded ? 'true' : 'false' }}" aria-controls="{{ banner_id }}" aria-label="{{ toggleText }}">
        <span class="cob-site-banner__chevron"></span>
      </button>
      <noscript>
        <a href="#{{ banner_id }}" class="cob-site-banner__toggle-icon" aria-label="{{ toggleText }}">
          <span class="cob-site-banner__chevron"></span>
        </a>
      </noscript>
    </div>
  </div>

  <div class="cob-site-banner__details" id="{{ banner_id }}" {{ isExpanded ? '' : 'hidden' }}>
    <div class="cob-site-banner__details-inner">
      <div class="cob-site-banner__info">
        <img src="{{ cityHallIcon }}" alt="City Hall Icon" class="cob-site-banner__info-icon" width="75" height="75" />
        <div>
          <strong>{{ officialWebsiteHeading }}</strong>
          <p>{{ officialWebsiteText }}</p>
        </div>
      </div>
      <div class="cob-site-banner__info">
        <img src="{{ httpsLockIcon }}" alt="HTTPS Lock Icon" class="cob-site-banner__info-icon" width="120" height="120" />
        <div>
          <strong>{{ secureWebsiteHeading }}</strong>
          <p>{{ secureWebsiteText }}</p>
        </div>
      </div>
    </div>
  </div>
</div> 
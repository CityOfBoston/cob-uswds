<div class="cob-slim-header{% if stickToTop %} cob-slim-header--sticky{% endif %}">
  <div class="cob-slim-header__content">
    <a href="{{ logoUrl }}" class="cob-slim-header__logo-link">
      <img src="./img/cob-boston-logo.svg" alt="{{ logoAlt }}" class="cob-slim-header__logo">
      <img src="./img/cob-boston-logo-mobile.svg" alt="{{ logoAlt }}" class="cob-slim-header__logo cob-slim-header__logo--mobile">
    </a>
    <span class="cob-slim-header__separator"></span>
    <p class="cob-slim-header__mayor-text">{{ mayorText }}</p>
    {% if additionalContent %}
      <div class="cob-slim-header__additional-content">{{ additionalContent }}</div>
    {% endif %}
  </div>
</div> 
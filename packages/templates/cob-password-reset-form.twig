<form class="cob-form">
  <legend class="cob-legend cob-legend--large">Reset password</legend>
  <fieldset class="cob-fieldset">
    <legend>Please enter your new password</legend>
    <div class="cob-alert cob-alert--info cob-alert--validation">
      <div class="cob-alert__body">
        <h3 class="cob-alert__heading">Password information</h3>
        <p class="cob-alert__text">
          Length requirements<br>Character constraints, if any
        </p>
      </div>
    </div>

    <label class="cob-label" for="password-reset">New password</label>
    <input class="cob-input" id="password-reset" name="password" type="password">

    <label class="cob-label" for="confirmPassword">Confirm password</label>
    <input class="cob-input" id="confirmPassword" name="confirmPassword" type="password">

    {% include "@components/_cob-password/src/cob-password.twig" with {
      'toggle': {
        'title': 'toggle password',
        'aria_controls': 'password-reset confirmPassword',
        'text': {
          'show': 'Show my typing',
          'hide': 'Hide my typing'
        }
      }
    }
    %}

    <input class="cob-button" type="submit" value="Reset password">
  </fieldset>
</form>
